# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored -- never commit real secrets.

# Port the site is reachable on from the Synology host (map your router/
# reverse-proxy to this port). Default 8080.
HOST_PORT=8080

# Admin dashboard credentials (http://<host>:8080/admin) -- shows
# submission counts, pageview stats, and lets you download submissions.csv.
# REQUIRED: docker compose refuses to start the api container without this set.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long-and-random
